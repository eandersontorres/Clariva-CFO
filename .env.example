# ── Supabase (same project as Clariva Kitchen) ──────────────────
VITE_SUPABASE_URL=https://huurnewugpwerkeusolt.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Tenant ───────────────────────────────────────────────────────
VITE_TENANT_ID=your_tenant_id_here

# ── App ──────────────────────────────────────────────────────────
VITE_APP_NAME=Clariva Ledger
VITE_APP_VERSION=1.0.0

# ── Server-side only (NO VITE_ prefix — never exposed to the browser) ──
# Service role key: lets /api/* functions read the RLS-locked Plaid token table.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Plaid (bank connection) ──────────────────────────────────────
# sandbox: test with fake creds user_good / pass_good.
# Bank of America needs PLAID_ENV=production + OAuth + PLAID_REDIRECT_URI.
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
PLAID_ENV=sandbox
# PLAID_REDIRECT_URI=https://cfo.clariva.cloud/   # production/OAuth only
